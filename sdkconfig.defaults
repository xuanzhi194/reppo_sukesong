# LVGL: use PSRAM-backed malloc instead of fixed 32KB internal pool
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="stdlib.h"

# Badge picture: JPEG from /badge via POSIX FS + SJPG decoder
CONFIG_LV_USE_SJPG=y
CONFIG_LV_USE_FS_POSIX=y
CONFIG_LV_FS_POSIX_LETTER=66
CONFIG_LV_FS_POSIX_PATH="/badge"
CONFIG_LV_FS_POSIX_CACHE_SIZE=0

# IRAM 优化（FREERTOS/RINGBUF/HEAP/SPI_FLASH_ROM → Flash）会导致 LVGL 从 Flash
# 读取大图时触发 "Cache disabled but cached memory region accessed"，已关闭。

# Serialize access to one TLS context; dynamic RX teardown raced ASR uploads.
# CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK is not set

# Keep TLS records in PSRAM for the connection lifetime. Certificate verification stays enabled.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# CONFIG_MBEDTLS_DYNAMIC_BUFFER is not set
