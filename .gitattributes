# Normalize text files to LF in repository for cross-platform consistency
* text=auto eol=lf

# Windows-native scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Common source/config files keep LF
*.sh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.cc text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf

# Binary files must never be line-normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.bin binary
*.elf binary
*.a binary
*.so binary
*.zip binary
*.gz binary
*.7z binary
*.pdf binary
